{
  "id": "drifter",
  "name": "Drifter",
  "abbrev": "DRFT",
  "version": "0.8.1",
  "description": "Chaotic bass drone inspired by the REON driftbox SIII: cross FM + hard sync, clean and dirty sub, ladder VCF, MOTION. Drones while Move plays",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "dsp.so",
  "ui_chain": "ui_chain.js",
  "component_type": "sound_generator",
  "capabilities": {
    "component_type": "sound_generator",
    "chainable": true,
    "audio_in": false,
    "audio_out": true,
    "midi_in": true,
    "midi_out": false,
    "chain_params": [
      {"key":"volume","name":"Volume","short_name":"VOLUME","type":"float","min":0,"max":1,"step":0.01,"default":0.7,"unit":"%"},
      {"key":"drift_x","name":"Drift X","short_name":"DRFT X","type":"float","min":-1,"max":1,"step":0.01,"default":0},
      {"key":"drift_y","name":"Drift Y","short_name":"DRFT Y","type":"float","min":-1,"max":1,"step":0.01,"default":0},
      {"key":"fm_drive","name":"FM Drive","short_name":"FM DRV","type":"float","min":0,"max":1,"step":0.01,"default":0.3,"unit":"%"},
      {"key":"sync_sweep","name":"Sync Sweep","short_name":"SWEEP","type":"float","min":0,"max":1,"step":0.01,"default":0.35,"unit":"%"},
      {"key":"vcf_cut","name":"Cutoff","short_name":"CUTOFF","type":"float","min":0,"max":1,"step":0.01,"default":0.55,"unit":"%"},
      {"key":"vcf_reso","name":"Resonance","short_name":"RESO","type":"float","min":0,"max":1,"step":0.01,"default":0.35,"unit":"%"},
      {"key":"motion","name":"Motion","short_name":"MOTION","type":"float","min":0,"max":1,"step":0.01,"default":0.35,"unit":"%"},
      {"key":"vco1_freq","name":"VCO1 Freq","short_name":"V1 FRQ","type":"float","min":0,"max":1,"step":0.01,"default":0.25,"unit":"%"},
      {"key":"vco2_freq","name":"VCO2 Freq","short_name":"V2 FRQ","type":"float","min":0,"max":1,"step":0.01,"default":0.3975,"unit":"%"},
      {"key":"vco_mix","name":"VCO Mix","short_name":"MIX","type":"float","min":0,"max":1,"step":0.01,"default":0.45,"unit":"%"},
      {"key":"bass","name":"Bass","short_name":"BASS","type":"float","min":0,"max":1,"step":0.01,"default":0.6,"unit":"%"},
      {"key":"dirty_sub","name":"Dirty Sub","short_name":"DIRTY","type":"float","min":0,"max":1,"step":0.01,"default":0.35,"unit":"%"},
      {"key":"delay","name":"Delay","short_name":"DELAY","type":"float","min":0,"max":1,"step":0.01,"default":0.3,"unit":"%"},
      {"key":"character","name":"Character","short_name":"CHAR","type":"enum","options":["FM","SYNC","FM+SYNC"],"default":2},
      {"key":"random_style","name":"Random Style","short_name":"STYLE","type":"enum","options":["Chaotic","Dark","Indust"],"default":0}
    ]
  }
}
