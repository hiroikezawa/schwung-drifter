{
  "id": "driftbox",
  "name": "Driftbox SIII",
  "abbrev": "DRFT",
  "version": "0.4.0",
  "description": "Mono 2-VCO cross-mod synth inspired by the REON driftbox SIII: FM/sync, audio-rate VCF mod, ladder VCF, LFO, delay, DRIFT X/Y",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "dsp.so",
  "component_type": "sound_generator",
  "capabilities": {
    "component_type": "sound_generator",
    "chainable": true,
    "audio_in": false,
    "audio_out": true,
    "midi_in": true,
    "midi_out": false,
    "chain_params": [
      {"key":"vco1_freq","name":"VCO1 Freq","short_name":"V1 FRQ","type":"float","min":0,"max":1,"step":0.01,"default":0.63,"unit":"%"},
      {"key":"vco1_mod","name":"VCO1 Mod","short_name":"V1 MOD","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"vco1_wave","name":"VCO1 Wave","short_name":"V1 WAV","type":"enum","options":["Saw","Tri","Sqr","Puls","Nois"],"default":0},
      {"key":"vco1_mode","name":"VCO1 FM/Sync","short_name":"V1 F/S","type":"enum","options":["FM","Sync"],"default":0},
      {"key":"vco1_lfo","name":"LFO to VCO1","short_name":"LFO>V1","type":"enum","options":["Off","On"],"default":0},
      {"key":"vco1_vol","name":"VCO1 Vol","short_name":"V1 VOL","type":"float","min":0,"max":1,"step":0.01,"default":0.8,"unit":"%"},
      {"key":"vco2_freq","name":"VCO2 Freq","short_name":"V2 FRQ","type":"float","min":0,"max":1,"step":0.01,"default":0.5655,"unit":"%"},
      {"key":"vco2_mod","name":"VCO2 Mod","short_name":"V2 MOD","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"vco2_wave","name":"VCO2 Wave","short_name":"V2 WAV","type":"enum","options":["Saw","Tri","Sqr","Puls","Nois"],"default":2},
      {"key":"vco2_mode","name":"VCO2 FM/Sync","short_name":"V2 F/S","type":"enum","options":["FM","Sync"],"default":0},
      {"key":"vco2_lfo","name":"LFO to VCO2","short_name":"LFO>V2","type":"enum","options":["Off","On"],"default":0},
      {"key":"vco2_vol","name":"VCO2 Vol","short_name":"V2 VOL","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"vcf_cut","name":"VCF Cutoff","short_name":"CUTOFF","type":"float","min":0,"max":1,"step":0.01,"default":0.7,"unit":"%"},
      {"key":"vcf_reso","name":"VCF Reso","short_name":"RESO","type":"float","min":0,"max":1,"step":0.01,"default":0.3,"unit":"%"},
      {"key":"vcf_mod","name":"VCF Mod","short_name":"VCF MD","type":"float","min":0,"max":1,"step":0.01,"default":0,"unit":"%"},
      {"key":"vcf_vco1","name":"VCO1 to VCF","short_name":"V1>VCF","type":"enum","options":["Off","On"],"default":0},
      {"key":"vcf_vco2","name":"VCO2 to VCF","short_name":"V2>VCF","type":"enum","options":["Off","On"],"default":0},
      {"key":"vcf_lfo","name":"LFO to VCF","short_name":"LFO>F","type":"enum","options":["Off","On"],"default":0},
      {"key":"lfo_rate","name":"LFO Rate","short_name":"RATE","type":"float","min":0,"max":1,"step":0.01,"default":0.4,"unit":"%"},
      {"key":"lfo_wave","name":"LFO Wave","short_name":"LFO WV","type":"enum","options":["Tri","Sqr"],"default":0},
      {"key":"delay_time","name":"Delay Time","short_name":"D.TIME","type":"float","min":0,"max":1,"step":0.01,"default":0.5,"unit":"%"},
      {"key":"delay_feedback","name":"Feedback","short_name":"F.B","type":"float","min":0,"max":1,"step":0.01,"default":0.25,"unit":"%"},
      {"key":"drift_x","name":"Drift X","short_name":"DRFT X","type":"float","min":-1,"max":1,"step":0.01,"default":0},
      {"key":"drift_x_target","name":"X Target","short_name":"X TGT","type":"enum","options":["VCO","D.Tm"],"default":0},
      {"key":"drift_y","name":"Drift Y","short_name":"DRFT Y","type":"float","min":-1,"max":1,"step":0.01,"default":0},
      {"key":"drift_y_target","name":"Y Target","short_name":"Y TGT","type":"enum","options":["VCF","F.B"],"default":0},
      {"key":"gate_hold","name":"Gate Hold","short_name":"HOLD","type":"enum","options":["Off","Play","Always"],"default":1},
      {"key":"trigger","name":"Trigger","short_name":"TRIG","type":"enum","options":["-","Trig"],"default":0,"access":"write"},
      {"key":"volume","name":"Volume","short_name":"VOLUME","type":"float","min":0,"max":1,"step":0.01,"default":0.7,"unit":"%"}
    ]
  }
}
