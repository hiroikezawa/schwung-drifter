{
  "title": "Drifter",
  "children": [
    {
      "title": "Playing",
      "lines": [
        "A bass drone after the",
        "REON driftbox SIII.",
        "Press Play on Move:",
        "it drones. Stop: it",
        "fades out. Notes do",
        "nothing at all."
      ]
    },
    {
      "title": "MAIN page",
      "lines": [
        "1 VOLUME",
        "2 DRFT X VCO2 vs VCO1",
        "3 DRFT Y VCF audio mod",
        "4 FM DRV cross FM",
        "5 SWEEP sync overtones",
        "6 CUT 7 RESO 8 MOTION"
      ]
    },
    {
      "title": "SETUP page",
      "lines": [
        "1 V1 FRQ 27-440 Hz",
        "2 V2 FRQ 3 MIX V1/V2",
        "4 BASS 5 DIRTY sub",
        "6 DELAY one knob",
        "7 CHAR FM/SYNC/FM+SYNC",
        "8 STYLE for RANDOM"
      ]
    },
    {
      "title": "DRIFT X / Y",
      "lines": [
        "Centre 0; right goes",
        "much higher than left.",
        "X: VCO2 vs VCO1,",
        "-1 .. +3 octaves.",
        "Y: VCOs shake the VCF;",
        "+Y also opens it."
      ]
    },
    {
      "title": "Bass",
      "lines": [
        "BASS: clean sine sub",
        "plus a dirty one, on",
        "VCO1 note, 40-80 Hz.",
        "No FM, after the VCF.",
        "DIRTY: grit and wobble",
        "of the dirty sub."
      ]
    },
    {
      "title": "MOTION",
      "lines": [
        "0: nothing moves.",
        "Up: slow, never-",
        "repeating drift of",
        "FM, sync, VCF mod and",
        "cutoff. Top: chaotic.",
        "Bass and level stay."
      ]
    },
    {
      "title": "RANDOM pad",
      "lines": [
        "Screen open: top-right",
        "pad = RANDOM. A new",
        "drone in the STYLE on",
        "SETUP. DRIFT X/Y go to",
        "0. VOLUME, CHAR, STYLE",
        "never change."
      ]
    },
    {
      "title": "Delay",
      "lines": [
        "One knob: 0 = none.",
        "Up: longer, more",
        "repeats, darker.",
        "Top: 0.9 s, deep and",
        "dark, never runs away."
      ]
    }
  ]
}
