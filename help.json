{
  "title": "DRIFTER",
  "children": [
    {
      "title": "Playing",
      "lines": [
        "Mono 2-VCO synth after",
        "the REON driftbox SIII.",
        "Notes open the gate;",
        "no envelope. Last note",
        "has priority. FREQ is",
        "the pitch at C4."
      ]
    },
    {
      "title": "MAIN page",
      "lines": [
        "1 VOLUME",
        "2 DRFT X 3 DRFT Y",
        "4 V1 FRQ 0.3Hz-14kHz",
        "5 V1 MOD FM from VCO2",
        "6 V2 FRQ 7 V2 MOD",
        "8 SUB sine 1 oct below"
      ]
    },
    {
      "title": "MIX/VCF page",
      "lines": [
        "1 V1 VOL 2 V2 VOL",
        "3 CUTOFF 4 RESO",
        "5 VCF MD mod depth",
        "6 RATE LFO 0.02-200Hz",
        "7 D.TIME 10ms-1s",
        "8 F.B 0 = no delay"
      ]
    },
    {
      "title": "SETUP 1 page",
      "lines": [
        "1 X TGT VCO / D.Tm",
        "2 Y TGT VCF / F.B",
        "3,5 WAV Saw Tri Sqr",
        "  Puls Nois",
        "4,6 F/S FM or Sync",
        "7,8 LFO>V1 LFO>V2"
      ]
    },
    {
      "title": "SETUP 2 page",
      "lines": [
        "1-3 V1/V2/LFO > VCF",
        "4 LFO WV Tri / Sqr",
        "5 HOLD Play=on while",
        "  Move plays (dflt),",
        "  Always=drone, Off",
        "6 TRIG gate 0.2 s"
      ]
    },
    {
      "title": "Bass",
      "lines": [
        "SUB: sine one octave",
        "below VCO1, no FM,",
        "added after the VCF:",
        "stays full at any",
        "CUTOFF or RESO.",
        "Lower V1 FRQ for more."
      ]
    },
    {
      "title": "Delay",
      "lines": [
        "F.B 0 = no delay.",
        "Raising F.B brings in",
        "the echo and repeats.",
        "Top: a saturating wash.",
        "D.TIME 10ms-1s glides:",
        "turning it bends pitch."
      ]
    }
  ]
}
