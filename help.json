{
  "title": "Driftbox SIII",
  "children": [
    {
      "title": "Playing",
      "lines": [
        "Mono 2-VCO synth after",
        "the REON driftbox SIII.",
        "Notes open the gate;",
        "no envelope. Last note",
        "has priority. FREQ is",
        "the pitch at C4."
      ]
    },
    {
      "title": "Main knobs",
      "lines": [
        "1 VOLUME",
        "2 DRFT X 3 DRFT Y",
        "4 V1 FRQ 0.3Hz-14kHz",
        "5 V1 MOD FM from VCO2",
        "6 V2 FRQ 7 V2 MOD",
        "8 CUTOFF"
      ]
    },
    {
      "title": "VCF/DLY page",
      "lines": [
        "1 RESO 2 D.TIME 3 F.B",
        "4 X TGT: DRFT X moves",
        "  VCO +-3oct or D.Tm",
        "5 Y TGT: DRFT Y moves",
        "  VCF +-5oct or F.B",
        "6 TRIG: gate 0.2 s"
      ]
    },
    {
      "title": "VCO page",
      "lines": [
        "WAV Saw Tri Sqr Puls",
        "  Nois (provisional)",
        "F/S: FM, or Sync to",
        "  the other VCO",
        "LFO>V: LFO into MOD",
        "VOL: mixer level"
      ]
    },
    {
      "title": "MOD/LFO page",
      "lines": [
        "VCF MD: depth for the",
        "  VCO1/VCO2/LFO > VCF",
        "  switches (audio rate)",
        "RATE 0.02-200Hz",
        "HOLD: Play=on while",
        "  Move plays (dflt),",
        "  Always=drone, Off"
      ]
    },
    {
      "title": "Delay",
      "lines": [
        "F.B 0 = no delay.",
        "Raising F.B brings in",
        "the echo and repeats.",
        "Top: a saturating wash.",
        "D.TIME 10ms-1s glides:",
        "turning it bends pitch."
      ]
    }
  ]
}
